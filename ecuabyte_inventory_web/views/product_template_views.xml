<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_tree_view_inherit_publish_shop" model="ir.ui.view">
        <field name="name">product.template.tree.inherit.publish.shop</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="before">
                <field name="x_publish_to_shop" widget="boolean_toggle" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
